  "cleaning_rules": {
    "negative_codes": {
      "-1": "refusal",
      "-2": "do not know",
      "-3": "invalid skip",
      "-4": "valid skip",
      "-5": "noninterview",
      "-7": "missing/not in relevant released universe (common in Child/YA file)"
    },
    "wages": "Keep amount>=0, including true reported zero. No separate wage-receipt screen Q13-4 or Q15-4 was found in selected waves. Do not turn any negative wage amount into0. Keep nonresponse/skip codes missing. Exclude missing annual readings from the observation count; never use them as zero in an average.",
    "military": "When civilian and military are combined: military_screen=0 implies military component0. If military_screen=1, require a nonnegative military amount. Other negative/missing screens or amounts remain missing; do not blanket-recode -4. For YA2000+ do not add a second military component because it is already included.",
    "inflation": "Deflate EACH annual income using its own actual income reference year before taking arithmetic means. Then take log of positive means; do not average annual logs if claiming log of average earnings.",
    "logs": "Averaged incomes may include genuine zero years. Only a strictly positive income/mean can enter a log-log model. For annual-vs-average comparison require a positive selected annual observation on the same child-mother pairs, and report the selection.",
    "deduplication": "Audit unique(person_id,income_year) before aggregation. YA2014+ uses actual interview_year−1; exceptionally late2016 interviews in2018 can overlap income2017 with a2018 interview. If duplicate annual readings exist use a documented deterministic rule and report counts; never count one calendar year twice.",
    "sample_and_variance": "Any longitudinal complete-case estimates are not automatically nationally representative. Use custom longitudinal weights for a national claim; otherwise call this an unweighted linked-sample tutorial. Cluster uncertainty by mother for sibling dependence; this alone is not a complete original multistage survey-design adjustment.",
    "fielding": "YA respondents older than30 are generally fielded every FOUR years from2010, not every2. Observation counts in age windows vary. Report number of observed annual incomes and do not call a3-wave average a3-consecutive-year average."
  },
